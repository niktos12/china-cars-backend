# ── Бэкенд (Express API) ────────────────────────────────────────────────

# Строка подключения к PostgreSQL (Railway / Neon / локальный Postgres).
# Пустая или отсутствует → работает демо-режим (данные в памяти процесса).
DATABASE_URL=

# Порт API. На Railway переменная PORT подставляется автоматически.
PORT=4000

# Логин и пароль админки (/admin). ОБЯЗАТЕЛЬНО переопределите на проде!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Секрет подписи сессионной cookie админки.
# ДОЛЖЕН совпадать с ADMIN_SESSION_SECRET на фронтенде!
ADMIN_SESSION_SECRET=dev-secret-change-me-on-railway

# Разрешённые источники для прямых CORS-запросов к API (через запятую).
# * — разрешить всем. Сайт ходит через прокси Next.js (same-origin), CORS ему не нужен.
CORS_ORIGIN=*
