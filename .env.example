# --- База данных (Neon/Supabase через маркетплейс Vercel, pooled-строка) ---
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# --- Админка (создаётся в Vercel -> Settings -> Environment Variables) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=поменяйте-на-надёжный-пароль
# Длинная случайная строка, например: openssl rand -hex 32
ADMIN_JWT_SECRET=замените-на-случайную-строку-минимум-32-символа

# --- CORS: домены, с которых разрешены запросы к API ---
# Можно несколько через запятую. Не задано = разрешены все.
CORS_ORIGIN=http://localhost:3000,https://ваш-фронт.vercel.app

# --- Локальный порт (на Vercel игнорируется) ---
PORT=3001
